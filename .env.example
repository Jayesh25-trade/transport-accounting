# ============================================================
# Transport + Billing + Accounting Management System
# Environment Configuration — EXAMPLE FILE
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/transport_acc

# Application
NEXT_PUBLIC_APP_NAME="Transport Accounting System"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Node environment
NODE_ENV=development
